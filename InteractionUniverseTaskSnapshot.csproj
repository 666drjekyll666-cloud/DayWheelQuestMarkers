<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>DayWheelQuestMarkers.InteractionUniverseTaskSnapshot</AssemblyName>
    <RootNamespace>CalendarQuestsPins</RootNamespace>
    <Version>0.1.3</Version>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\InteractionUniverseTaskSnapshot\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\InteractionUniverseTaskSnapshotProbe.cs" />
    <Compile Include="src\ReflectionUtil.cs" />
    <Compile Include="src\WeekdayInteractionRuleCache.cs" />
    <Compile Include="src\NavigationReachabilityCache.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.BaseLib" Version="5.4.21" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="Unity3D.SDK" Version="2020.3.13.1" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
